[Unit]
Description=Encrypt and verify an off-site LifeApp database backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=lifeapp-ops
SupplementaryGroups=docker
EnvironmentFile=/srv/lifeapp/backup.env
ExecStart=/usr/bin/python3 /srv/lifeapp/backup/automatic-server-backup.py capture
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=45min
